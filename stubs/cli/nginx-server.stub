# Laika server block. Complete and self-contained -- it includes no other
# file from the project. Drop it in /etc/nginx/sites-available/ and symlink
# it into sites-enabled/, or paste it into your existing nginx config.
#
#   nginx -t && systemctl reload nginx

server {
    listen {{port}};
    listen [::]:{{port}};

    server_name {{domain}};
    # public/ is the document root; everything else in the project stays
    # out of reach of the web server.
    root {{root}}/public;

    index index.php;
    charset utf-8;

    client_max_body_size {{upload}};

{{rules}}

    # The only PHP that is ever executed. An exact-match location cannot be
    # reached by any other path, so no file other than the front controller
    # can be run -- and public/ holds nothing else anyway. It also terminates
    # the rewrite above; without this block that rewrite loops.
    location = /index.php {
        fastcgi_pass {{fastcgi}};
        fastcgi_index index.php;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;

        # Laika reads the Authorization header for token guards
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }

    access_log {{root}}/lf-logs/nginx-access.log;
    error_log  {{root}}/lf-logs/nginx-error.log;
}
