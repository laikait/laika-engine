# These deny rules are defence in depth, not the primary control. The
# document root is public/, so the project root (lf-*, vendor/,
# composer.json) is not reachable by URL at all, and the front controller
# at the bottom sends every request to PHP, where Laika's
# Dispatcher::serveAsset() decides what is servable. The rules stay because
# they cost nothing and still hold if the document root is ever pointed at
# the project root by mistake.
#
# nginx picks the FIRST matching regex location, so these must stay above
# the PHP handler.

# Framework internals. Nothing under lf-* is ever a public asset --
# lf-storage/keys/app.key above all. Covers every current and future lf-*
# directory.
location ~ ^/(lf-[a-z]+|vendor|docs)(/|$) {
    deny all;
}

# Dotfiles: .env, .git, .htaccess, .gitignore
location ~ /\. {
    deny all;
}

# Never execute anything uploaded. A .php dropped into uploads/ must be
# served as bytes at most, never handed to FastCGI.
location ~ ^/uploads/.*\.(php|phar|phtml|phps)$ {
    deny all;
}

# Sensitive files at the project root. The optional .bat arm is not dead:
# the generator no longer writes laika.bat/worker.bat, but a hand-written
# one is deliberately left in place (see ScriptHandler::prune), so it still
# needs denying.
location ~ ^/(composer\.(json|lock)|(laika|worker)(\.bat)?|nginx\.conf|phpunit\.xml.*|phpcs\.xml)$ {
    deny all;
}

# Front controller. Every request is rewritten to public/index.php -- including one
# that maps to a real file on disk -- so Laika's Dispatcher decides what may
# be served, instead of nginx handing files out before PHP ever runs. That is
# what makes the app-level checks in Dispatcher::serveAsset() authoritative.
#
# Trade-off: static assets are served by PHP, not by nginx's static path, so
# they lose sendfile and byte-range handling. "try_files $uri" cannot undo
# that on its own: assets/, template/ and uploads/ live in the project root,
# outside the public/ document root, so nginx cannot see them. To have nginx
# serve the bytes while PHP still decides who may read them, use the
# "sendfile" key in lf-config/assets.php (X-Accel-Redirect) -- see the
# deployment guide.
#
# "last" restarts the location search, which "location = /index.php" then
# terminates. Without that handler this rewrite loops.
location / {
    # Handle Authorization Header
    if ($http_authorization != "") {
        set $auth_header $http_authorization;
    }

    rewrite ^ /index.php last;
}
