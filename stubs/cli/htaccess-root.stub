# The document root is public/. Nothing in the project root is ever
# served directly -- point your vhost's DocumentRoot at public/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
