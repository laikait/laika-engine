<?xml version="1.0" encoding="UTF-8"?>
<!--
    Each module runs in its own process with its own bootstrap, because the
    suites need different APP_PATH values and a constant can be defined once.
    Run them all with `composer test`, or one with e.g.
    the matching line in composer.json "scripts.test". The bootstraps are passed as
    auto_prepend_file, not as bootstrap: vendor/bin/phpunit loads the autoloader,
    and with it helpers/loader.php, before any bootstrap runs, so only a prepend
    file can define APP_PATH first.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         testdox="true"
         failOnEmptyTestSuite="false">
    <testsuites>
        <testsuite name="Cache">
            <directory>tests/Cache</directory>
        </testsuite>
        <testsuite name="Core">
            <directory>tests/Core</directory>
        </testsuite>
        <testsuite name="Model">
            <directory>tests/Model</directory>
        </testsuite>
        <testsuite name="Route">
            <directory>tests/Route</directory>
        </testsuite>
        <testsuite name="Session">
            <directory>tests/Session</directory>
        </testsuite>
        <testsuite name="Shield">
            <directory>tests/Shield</directory>
            <exclude>tests/Shield/Stubs</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
